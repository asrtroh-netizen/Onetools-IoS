diff --git a/apple/ClashClient/Sources/OneTools/OneToolsRootShellView.swift b/apple/ClashClient/Sources/OneTools/OneToolsRootShellView.swift
new file mode 100644
index 0000000000000000000000000000000000000000..75c696445415e1bb694a0d09f83fe6d93125bad5
--- /dev/null
+++ b/apple/ClashClient/Sources/OneTools/OneToolsRootShellView.swift
@@ -0,0 +1,335 @@
+#if os(iOS)
+import ClashClientUI
+import OneUI
+import SwiftUI
+import UIKit
+
+public enum OneToolsTab: Int, CaseIterable, Sendable {
+    case proxy = 0
+    case adblock = 1
+    case signing = 2
+    case toolbox = 3
+
+    var dockItem: UltraGlassDock.Item {
+        switch self {
+        case .proxy:
+            return .init(id: "proxy", icon: "router_outlined", label: "代理")
+        case .adblock:
+            return .init(id: "adblock", icon: "shield_outlined", label: "去广告")
+        case .signing:
+            return .init(id: "signing", icon: "verified_user_outlined", label: "自签")
+        case .toolbox:
+            return .init(id: "toolbox", icon: "dashboard_outlined", label: "工具箱")
+        }
+    }
+}
+
+@MainActor
+final class OneToolsShellRouter: ObservableObject {
+    static let shared = OneToolsShellRouter()
+
+    @Published var selectedIndex: Int = OneToolsTab.proxy.rawValue
+    @Published var lastOneWifiPairingURL: String?
+    @Published var lastFeatherURL: String?
+    @Published var bannerMessage: String?
+
+    private init() {}
+
+    func handleIncomingURL(_ url: URL) -> Bool {
+        guard let scheme = url.scheme?.lowercased() else { return false }
+        if scheme == "feather" {
+            selectedIndex = OneToolsTab.signing.rawValue
+            lastFeatherURL = url.absoluteString
+            return true
+        }
+        guard scheme == "onetools" else { return false }
+        let host = url.host?.lowercased() ?? ""
+        switch host {
+        case "tab":
+            let slug = url.pathComponents.dropFirst().first?.lowercased() ?? ""
+            switch slug {
+            case "proxy", "clash": selectedIndex = OneToolsTab.proxy.rawValue
+            case "adblock", "swipt": selectedIndex = OneToolsTab.adblock.rawValue
+            case "signing", "feather": selectedIndex = OneToolsTab.signing.rawValue
+            case "toolbox", "more": selectedIndex = OneToolsTab.toolbox.rawValue
+            default: break
+            }
+            return true
+        case "onewifi":
+            lastOneWifiPairingURL = url.absoluteString
+            selectedIndex = OneToolsTab.toolbox.rawValue
+            bannerMessage = "已接收 OneWIFI 配对链接，等待互通模块接入"
+            return true
+        default:
+            return false
+        }
+    }
+}
+
+/// OneTools iOS 根外壳（P5.0）：保持 `AppShellView` 常驻挂载以保留 VPN 与订阅状态，
+/// 底部叠加 `OneUI` 手写液态胶囊底栏 `UltraGlassDock` 切换四大核心工作区。
+struct OneToolsRootShellView<ProxyContent: View>: View {
+    private static let shellEnabledKey = "onetools.shell.enabled"
+
+    @AppStorage(Self.shellEnabledKey) private var shellEnabled: Bool = true
+    @StateObject private var router = OneToolsShellRouter.shared
+    private let proxyContent: ProxyContent
+
+    init(@ViewBuilder proxyContent: () -> ProxyContent) {
+        self.proxyContent = proxyContent()
+    }
+
+    private var dockItems: [UltraGlassDock.Item] {
+        OneToolsTab.allCases.map(\.dockItem)
+    }
+
+    var body: some View {
+        if shellEnabled {
+            ZStack(alignment: .bottom) {
+                proxyContent
+                    .safeAreaInset(edge: .bottom, spacing: 0) {
+                        Color.clear.frame(height: OneMetrics.dockHeight + OneMetrics.space24)
+                    }
+                    .opacity(router.selectedIndex == OneToolsTab.proxy.rawValue ? 1 : 0)
+                    .allowsHitTesting(router.selectedIndex == OneToolsTab.proxy.rawValue)
+                    .accessibilityHidden(router.selectedIndex != OneToolsTab.proxy.rawValue)
+
+                if router.selectedIndex == OneToolsTab.adblock.rawValue {
+                    adblockTab
+                        .transition(.opacity)
+                } else if router.selectedIndex == OneToolsTab.signing.rawValue {
+                    signingTab
+                        .transition(.opacity)
+                } else if router.selectedIndex == OneToolsTab.toolbox.rawValue {
+                    OneToolsToolboxView(router: router, shellEnabled: $shellEnabled)
+                        .oneTheme()
+                        .transition(.opacity)
+                }
+
+                UltraGlassDock(items: dockItems, selectedIndex: $router.selectedIndex)
+            }
+            .onOpenURL { url in
+                _ = router.handleIncomingURL(url)
+            }
+        } else {
+            proxyContent
+                .onOpenURL { url in
+                    if url.scheme?.lowercased() == "onetools", url.host?.lowercased() == "shell" {
+                        shellEnabled = true
+                    }
+                }
+        }
+    }
+
+    @ViewBuilder
+    private var adblockTab: some View {
+        #if canImport(SwiptUI)
+        SwiptRootView()
+        #else
+        OneToolsAdblockHubView(router: router)
+            .oneTheme()
+        #endif
+    }
+
+    @ViewBuilder
+    private var signingTab: some View {
+        #if canImport(FeatherUI)
+        FeatherRootView()
+        #else
+        OneToolsSigningHubView(router: router)
+            .oneTheme()
+        #endif
+    }
+}
+
+private struct OneToolsAdblockHubView: View {
+    @ObservedObject var router: OneToolsShellRouter
+    @State private var copiedPlugin = false
+
+    private var appGroupDefaults: UserDefaults? {
+        UserDefaults(suiteName: ClashAppIdentifiers.appGroup)
+    }
+
+    private var loopbackEnabled: Bool {
+        ClashTunnelRouteShaping.swiptLoopbackEnabled(in: appGroupDefaults)
+    }
+
+    private var bundledPluginText: String? {
+        guard let url = Bundle.main.url(forResource: "onetools-cn-ads", withExtension: "plugin") else {
+            return nil
+        }
+        return try? String(contentsOf: url, encoding: .utf8)
+    }
+
+    var body: some View {
+        OnePage {
+            PageHead("去广告", desc: "网络层 Loon 模块引擎 + 界面层 Swipt 自动跳过") {
+                Nameplate.ready("双层拦截", detail: "12 规则")
+            }
+
+            OneStatusHero(
+                tone: loopbackEnabled ? .healthy : .attention,
+                title: loopbackEnabled ? "环回兼容已开启" : "环回兼容已关闭",
+                subtitle: loopbackEnabled
+                    ? "Clash 隧道已配置注入 \(ClashTunnelRouteShaping.swiptLoopbackAddress)，可直接承载 Swipt"
+                    : "请在「工具箱」或「隧道设置」开启 Swipt 兼容以提供 10.7.0.1 环回地址",
+                detail: "无需额外安装 LocalDevVPN，单 VPN 通道同时服务代理与界面跳过",
+                action: HeroAction("前往代理页") {
+                    router.selectedIndex = OneToolsTab.proxy.rawValue
+                }
+            )
+
+            OneSection("网络层 · 自有国内广告规则", desc: "已内置经双源交叉验证的 onetools-cn-ads.plugin", systemImage: "shield_outlined", tone: .green) {
+                VStack(alignment: .leading, spacing: OneMetrics.space12) {
+                    SoftLabelGrid([
+                        SoftLabel("内置插件", value: bundledPluginText != nil ? "已随包内置" : "待打包资源"),
+                        SoftLabel("覆盖 SDK", value: "8 家核心 / 12 条规则"),
+                        SoftLabel("引擎基础", value: "Clash Module Engine"),
+                        SoftLabel("兼容语法", value: "Loon / Surge / QX"),
+                    ])
+                    HStack(spacing: OneMetrics.space8) {
+                        OneFilledButton(copiedPlugin ? "已复制规则内容" : "复制内置 Loon 插件") {
+                            if let text = bundledPluginText {
+                                UIPasteboard.general.string = text
+                                copiedPlugin = true
+                            }
+                        }
+                        OneOutlinedButton("打开模块管理") {
+                            router.selectedIndex = OneToolsTab.proxy.rawValue
+                        }
+                    }
+                }
+            }
+
+            OneSection("界面层 · Swipt 自动化仓位", desc: "G2 双 Go 运行时实测通过后直接挂载 SwiptRootView", systemImage: "extension_outlined", tone: .teal) {
+                SoftLabelGrid([
+                    SoftLabel("环回对端", value: ClashTunnelRouteShaping.swiptLoopbackAddress, mono: true),
+                    SoftLabel("默认规则", value: "跳过中国广告 (fuzzySkip)"),
+                    SoftLabel("最低系统", value: "iOS 17.4+"),
+                    SoftLabel("引导改造", value: "已移除 LocalDevVPN 依赖"),
+                ])
+            }
+        }
+    }
+}
