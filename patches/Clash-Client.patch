+                                .font(OneText.bodySmall())
+                                .foregroundStyle(OnePalette.onSurfaceVariant)
+                        }
+                        Spacer()
+                        SystemSwitch(isOn: $publicBlurFallback)
+                    }
+                }
+            }
+
+            OneSection("后期互通与深链记录", systemImage: "link_outlined", tone: .teal) {
+                VStack(alignment: .leading, spacing: OneMetrics.space12) {
