+func executableName(base string) string {
+	if runtime.GOOS == "windows" {
+		return base + ".exe"
+	}
+	return base
+}
+
+// buildIsolatedGomobileTools builds a Swipt-private gomobile + gobind pair whose
+// Objective-C runtime bridge classes (SwiptGoSeqRef, SwiptRefTracker, SwiptRefCounter,
+// swiptGoSeqDictionary, swiptGoSeqRefInterface, SwiptUniverseerror) never collide in
+// libobjc with Clash.framework's unprefixed GoSeqRef classes when embedded in OneTools.
+func buildIsolatedGomobileTools(gomobileVersion string) string {
+	srcDir := gomobileModuleSourceDir()
+	workRoot, err := filepath.Abs(filepath.Join(".build", "gomobile-swipt"))
+	if err != nil {
+		log.Fatal(err)
+	}
+	sum := sha256.Sum256([]byte(gomobileVersion + "|" + patchStampVer + "|" + runtime.Version() + "|" + workRoot))
+	key := hex.EncodeToString(sum[:8])
+
+	stageSrc := filepath.Join(workRoot, "src-"+key)
+	binDir := filepath.Join(workRoot, "bin-"+key)
+	gomobileBin := filepath.Join(binDir, executableName("gomobile"))
+	gobindBin := filepath.Join(binDir, executableName("gobind"))
+	if fileExists(gomobileBin) && fileExists(gobindBin) && fileExists(filepath.Join(stageSrc, "bind", "objc", "ref.h")) {
+		return binDir
+	}
+
+	_ = os.RemoveAll(stageSrc)
+	if err := copyPatchedGomobileTree(srcDir, stageSrc); err != nil {
+		log.Fatal("stage patched gomobile: ", err)
+	}
+	if err := os.MkdirAll(binDir, 0o755); err != nil {
+		log.Fatal(err)
+	}
+
+	for _, tool := range []string{"gomobile", "gobind"} {
+		out := filepath.Join(binDir, executableName(tool))
+		cmd := exec.Command("go", "build", "-trimpath", "-o", out, "./cmd/"+tool)
+		cmd.Dir = stageSrc
+		run(cmd)
+	}
+	return binDir
+}
+
+func gomobileModuleSourceDir() string {
+	dl := exec.Command("go", "mod", "download", gomobileModule)
+	run(dl)
+	cmd := exec.Command("go", "list", "-m", "-f", "{{.Dir}}", gomobileModule)
+	out, err := cmd.Output()
+	if err != nil {
+		log.Fatal("resolve ", gomobileModule, " dir: ", err)
+	}
+	dir := strings.TrimSpace(string(out))
+	if dir == "" {
+		log.Fatal("empty module dir for ", gomobileModule)
+	}
+	return dir
+}
+
+func copyPatchedGomobileTree(srcRoot, dstRoot string) error {
+	replacements := [][2]string{
+		{"GoSeqRef", "SwiptGoSeqRef"},
+		{"RefTracker", "SwiptRefTracker"},
+		{"RefCounter", "SwiptRefCounter"},
+		{"goSeqDictionary", "swiptGoSeqDictionary"},
+		{"goSeqRefInterface", "swiptGoSeqRefInterface"},
+	}
+
+	return filepath.WalkDir(srcRoot, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(srcRoot, path)
+		if err != nil {
+			return err
+		}
+		target := filepath.Join(dstRoot, rel)
+		if d.IsDir() {
+			return os.MkdirAll(target, 0o755)
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		slashRel := filepath.ToSlash(rel)
+		if strings.HasPrefix(slashRel, "bind/") && !strings.HasPrefix(slashRel, "bind/java/") && !strings.HasSuffix(slashRel, "_test.go") {
+			for _, pair := range replacements {
+				data = bytes.ReplaceAll(data, []byte(pair[0]), []byte(pair[1]))
+			}
+			if slashRel == "bind/genobjc.go" {
+				oldPrefix := "func (g *ObjcGen) namePrefixOf(pkg *types.Package) string {\n\tif pkg == nil {\n\t\treturn \"Universe\"\n\t}"
+				newPrefix := "func (g *ObjcGen) namePrefixOf(pkg *types.Package) string {\n\tif pkg == nil {\n\t\treturn \"SwiptUniverse\"\n\t}"
+				if !bytes.Contains(data, []byte(oldPrefix)) {
+					return fmt.Errorf("unexpected namePrefixOf signature in %s", slashRel)
+				}
+				data = bytes.Replace(data, []byte(oldPrefix), []byte(newPrefix), 1)
+
+				oldInclude := "g.Printf(\"#include %q\\n\", g.namePrefix+\".objc.h\")"
+				newInclude := "if g.Pkg == nil {\n\t\tg.Printf(\"#include \\\"Universe.objc.h\\\"\\n\")\n\t} else {\n\t\tg.Printf(\"#include %q\\n\", g.namePrefix+\".objc.h\")\n\t}"
+				if !bytes.Contains(data, []byte(oldInclude)) {
+					return fmt.Errorf("unexpected Universe include line in %s", slashRel)
+				}
+				data = bytes.Replace(data, []byte(oldInclude), []byte(newInclude), 1)
+			}
+		}
+		if slashRel == "cmd/gobind/gen.go" {
+			// Ensure gobind copies ref.h / seq_darwin.* from our patched stage tree
+			// rather than resolving unpatched GOMODCACHE via Swipt/go.mod.
+			oldPkgDir := "func packageDir(path string) (string, error) {"
+			newPkgDir := fmt.Sprintf(
+				"func packageDir(path string) (string, error) {\n\tif strings.HasPrefix(path, %q) {\n\t\trel := strings.TrimPrefix(path, %q)\n\t\treturn filepath.Join(%q, filepath.FromSlash(rel)), nil\n\t}",
+				gomobileModule+"/",
+				gomobileModule+"/",
+				dstRoot,
+			)
+			if !bytes.Contains(data, []byte(oldPkgDir)) {
+				return fmt.Errorf("unexpected packageDir signature in %s", slashRel)
+			}
+			data = bytes.Replace(data, []byte(oldPkgDir), []byte(newPkgDir), 1)
+		}
+		return os.WriteFile(target, data, 0o644)
+	})
+}
