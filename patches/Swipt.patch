+
+    /// OneTools (P5.1 / D7): automatically install `skip-chinese-ads` from the official stable
+    /// repository on first launch and seed `fuzzySkip = true` in its SQLite settings table.
+    @available(iOS 17.4, *)
+    func bootstrapDefaultChineseAdSkipIfNeeded() async {
+        guard !UserDefaults.standard.bool(forKey: Self.defaultChineseAdSkipBootstrappedKey) else { return }
+        reload()
+        if !ids.contains(Self.skipChineseAdsID) {
+            let officialURL = Repository.stableCatalogURL
+            if repositories.first(where: { $0.url == officialURL }) == nil,
+               let fetched = try? await Self.fetchRepository(officialURL, etag: "") {
+                try? SwipletDatabase.save(fetched)
+                if let existingIdx = repositories.firstIndex(where: \.isOfficial) {
+                    repositories[existingIdx] = fetched
+                } else {
+                    repositories.insert(fetched, at: 0)
+                }
+            } else {
+                try? await refreshRepository(Repository.official.url, force: true)
+            }
+
+            if let repo = repositories.first(where: { $0.swiplets.contains(where: { $0.id == Self.skipChineseAdsID }) }),
+               let target = repo.swiplets.first(where: { $0.id == Self.skipChineseAdsID }),
+               Platform.shared.isSwipletCompatible(target) {
+                try? await install(target, from: repo)
+            }
+        }
+
+        if ids.contains(Self.skipChineseAdsID) {
+            seedFuzzySkipDefault()
+            try? await setServiceEnabled(Self.skipChineseAdsID, true)
+            UserDefaults.standard.set(true, forKey: Self.defaultChineseAdSkipBootstrappedKey)
+        }
+    }
+
+    private func seedFuzzySkipDefault() {
+        guard let dataDir = dataDirectory(of: Self.skipChineseAdsID) else { return }
+        try? FileManager.default.createDirectory(at: dataDir, withIntermediateDirectories: true)
+        let dbURL = dataDir.appendingPathComponent("skip-chinese-ads.db")
+        var handle: OpaquePointer?
+        guard sqlite3_open(dbURL.path, &handle) == SQLITE_OK, let db = handle else {
+            if let handle { sqlite3_close(handle) }
+            return
+        }
+        defer { sqlite3_close(db) }
+        let sql = """
+        CREATE TABLE IF NOT EXISTS settings (id INTEGER PRIMARY KEY, fuzzy_skip INTEGER NOT NULL DEFAULT 1, close_popups INTEGER NOT NULL DEFAULT 1);
+        INSERT OR IGNORE INTO settings (id, fuzzy_skip, close_popups) VALUES (1, 1, 1);
+        """
+        sqlite3_exec(db, sql, nil, nil, nil)
+    }
