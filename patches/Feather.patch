+enum FeatherBeamTone {
+	case emerald
+	case amber
+	case crimson
+
+	var color: Color {
+		switch self {
+		case .emerald:
+			return Color(red: 0.243, green: 0.812, blue: 0.557) // #3ECF8E
+		case .amber:
+			return Color(red: 0.898, green: 0.600, blue: 0.204) // #E59934
+		case .crimson:
+			return Color(red: 0.898, green: 0.325, blue: 0.325) // #E55353
+		}
+	}
+}
+
+struct FeatherBorderBeamModifier: ViewModifier {
+	let active: Bool
+	let tone: FeatherBeamTone
+	let radius: CGFloat
+	let duration: Double
+
+	@Environment(\.accessibilityReduceMotion) private var reduceMotion
+	@State private var angle: Double = 0
+
+	func body(content: Content) -> some View {
+		let shape = RoundedRectangle(cornerRadius: radius, style: .continuous)
+		content.overlay {
+			if active {
+				if reduceMotion {
+					shape
+						.strokeBorder(tone.color.opacity(0.65), lineWidth: 1.5)
+						.allowsHitTesting(false)
+				} else {
+					ZStack {
+						shape
+							.strokeBorder(beamGradient, lineWidth: 2.6)
+							.blur(radius: 3)
+							.opacity(0.40)
+						shape
+							.strokeBorder(beamGradient, lineWidth: 1.5)
+					}
+					.allowsHitTesting(false)
+					.onAppear {
+						angle = 0
+						withAnimation(.linear(duration: duration).repeatForever(autoreverses: false)) {
+							angle = 360
+						}
+					}
+				}
+			}
+		}
+	}
+
+	private var beamGradient: AngularGradient {
+		AngularGradient(
+			stops: [
+				.init(color: .clear, location: 0.00),
+				.init(color: .clear, location: 0.64),
+				.init(color: tone.color.opacity(0.28), location: 0.80),
+				.init(color: tone.color, location: 0.93),
+				.init(color: .white.opacity(0.90), location: 0.96),
+				.init(color: .clear, location: 1.00),
+			],
+			center: .center,
+			angle: .degrees(angle)
+		)
+	}
+}
+
+extension View {
+	func featherBorderBeam(
+		active: Bool,
+		tone: FeatherBeamTone,
+		radius: CGFloat,
+		duration: Double = 4.2
+	) -> some View {
+		modifier(FeatherBorderBeamModifier(active: active, tone: tone, radius: radius, duration: duration))
+	}
+}
