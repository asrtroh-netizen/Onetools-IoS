+@objc(OneToolsFeatherBridge)
+public final class OneToolsFeatherBridge: NSObject {
+	static let selectSubtabNotification = Notification.Name("OneToolsFeatherSelectSubtab")
+
+	@objc(makeRootViewController)
+	public static func makeRootViewController() -> UIViewController {
+		let controller = UIHostingController(rootView: FeatherRootView())
+		controller.view.backgroundColor = .clear
+		return controller
+	}
+
+	@objc(handleIncomingURL:)
+	public static func handleIncomingURL(_ url: URL) {
+		FeatherURLHandler.handle(url)
+	}
+
+	@objc(selectSubtab:)
+	public static func selectSubtab(_ rawName: String) {
+		FeatherBootstrap.ensureInitialized()
+		NotificationCenter.default.post(
