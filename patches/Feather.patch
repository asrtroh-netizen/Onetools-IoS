diff --git a/Feather/Utilities/Handlers/OneToolsSigningCoordinator.swift b/Feather/Utilities/Handlers/OneToolsSigningCoordinator.swift
new file mode 100644
index 0000000000000000000000000000000000000000..3dcf98b44f4f1727e5a7ec1012f51ac52fa460c0
--- /dev/null
+++ b/Feather/Utilities/Handlers/OneToolsSigningCoordinator.swift
@@ -0,0 +1,180 @@
+//
+//  OneToolsSigningCoordinator.swift
+//  Feather
+//
+
+import CoreData
+import Foundation
+import SigningLogic
+import UIKit
+import UserNotifications
+
+// MARK: - Certificate Expiry Notification Scheduler (P7)
+
+final class CertificateExpiryNotifier {
+    static let shared = CertificateExpiryNotifier()
+    private static let identifierPrefix = "onetools.cert.expiry."
+
+    private init() {}
+
+    func syncNotifications(now: Date = Date()) {
+        let certs = Storage.shared.getAllCertificates().filter { !$0.revoked }
+        let subjects: [ExpirySubject] = certs.compactMap { cert in
+            guard let uuid = cert.uuid else { return nil }
+            let exp = cert.expiration ?? Storage.shared.getProvisionFileDecoded(for: cert)?.ExpirationDate
+            guard let expiresOn = exp else { return nil }
+            return ExpirySubject(id: uuid, expiresOn: expiresOn)
+        }
+        let nicknameByID: [String: String] = Dictionary(
+            uniqueKeysWithValues: certs.compactMap { cert in
+                guard let uuid = cert.uuid else { return nil }
+                let title = (cert.nickname?.isEmpty == false ? cert.nickname : nil)
+                    ?? Storage.shared.getProvisionFileDecoded(for: cert)?.Name
+                    ?? uuid
+                return (uuid, title)
+            }
+        )
+
+        let alerts = ExpiryReminderPlanner.upcomingAlerts(for: subjects, now: now)
+        let center = UNUserNotificationCenter.current()
+
+        center.getPendingNotificationRequests { existing in
+            let staleIDs = existing
+                .map(\.identifier)
+                .filter { $0.hasPrefix(Self.identifierPrefix) }
+            if !staleIDs.isEmpty {
+                center.removePendingNotificationRequests(withIdentifiers: staleIDs)
+            }
+            guard !alerts.isEmpty else { return }
+
+            center.requestAuthorization(options: [.alert, .sound, .badge]) { granted, _ in
+                guard granted else { return }
+                let calendar = Calendar.current
+                for alert in alerts {
+                    let certTitle = nicknameByID[alert.id] ?? alert.id
+                    let content = UNMutableNotificationContent()
+                    switch alert.notice {
+                    case .sevenDays:
+                        content.title = "证书将在 7 天后到期"
+                        content.body = "「\(certTitle)」即将到期，建议提前导入新证书并使用一键全部重签。"
+                    case .oneDay:
+                        content.title = "证书明天到期"
+                        content.body = "「\(certTitle)」将于明天失效，请尽快一键重签所有已签应用。"
+                    }
+                    content.sound = .default
+
+                    let comps = calendar.dateComponents([.year, .month, .day, .hour, .minute], from: alert.fireDate)
+                    let trigger = UNCalendarNotificationTrigger(dateMatching: comps, repeats: false)
+                    let suffix = alert.notice == .sevenDays ? "7d" : "1d"
+                    let req = UNNotificationRequest(
+                        identifier: "\(Self.identifierPrefix)\(alert.id).\(suffix)",
+                        content: content,
+                        trigger: trigger
+                    )
+                    center.add(req)
+                }
+            }
+        }
+    }
+
+    func expiringSoonCount(withinDays limit: Int = 7, now: Date = Date()) -> Int {
+        let calendar = Calendar.current
+        return Storage.shared.getAllCertificates().filter { cert in
+            guard !cert.revoked else { return false }
+            guard let exp = cert.expiration ?? Storage.shared.getProvisionFileDecoded(for: cert)?.ExpirationDate,
+                  exp > now else {
+                return false
+            }
+            let days = calendar.dateComponents(
+                [.day],
+                from: calendar.startOfDay(for: now),
+                to: calendar.startOfDay(for: exp)
+            ).day ?? (limit + 1)
+            return days <= limit
+        }.count
+    }
+}
+
+// MARK: - Batch Signing & One-Click Re-sign Coordinator (P7)
+
+@MainActor
+final class BatchSigningCoordinator: ObservableObject {
+    static let shared = BatchSigningCoordinator()
+
+    @Published private(set) var isRunning = false
+    @Published private(set) var completedCount = 0
+    @Published private(set) var totalCount = 0
+    @Published var lastSummaryMessage: String?
+
+    private init() {}
+
+    func signBatch(
+        apps: [AppInfoPresentable],
+        certificate: CertificatePair?,
+        options: Options = OptionsManager.shared.options
+    ) async -> BatchReport<String, String> {
+        guard !apps.isEmpty else {
+            return BatchReport(successes: [], failures: [])
+        }
+        isRunning = true
+        completedCount = 0
+        totalCount = apps.count
+        defer { isRunning = false }
+
+        var byKey: [String: AppInfoPresentable] = [:]
+        var orderedKeys: [String] = []
+        for (idx, app) in apps.enumerated() {
+            let key = app.uuid ?? "app-\(idx)"
+            byKey[key] = app
+            orderedKeys.append(key)
+        }
+
+        let report = await Batch.runAsync(orderedKeys) { key async throws -> String in
+            guard let target = byKey[key] else {
+                throw SigningFileHandlerError.appNotFound
+            }
+            var itemOptions = options
+            itemOptions.appName = nil
+            itemOptions.appIdentifier = nil
+            itemOptions.appVersion = nil
+
+            let handler = SigningHandler(app: target, options: itemOptions)
+            handler.appCertificate = certificate
+            do {
+                try await handler.copy()
+                try await handler.modify()
+                try? await handler.clean()
+                await MainActor.run {
+                    self.completedCount += 1
+                }
+                return target.name ?? key
+            } catch {
+                try? await handler.clean()
+                await MainActor.run {
+                    self.completedCount += 1
+                }
+                throw error
+            }
+        }
+
+        let okCount = report.successes.count
+        let failCount = report.failures.count
+        if failCount == 0 {
+            lastSummaryMessage = "批量签名完成：成功 \(okCount) 个应用。"
+        } else {
+            let details = report.failures.prefix(3).map { "\($0.item): \($0.errorDescription)" }.joined(separator: "\n")
+            lastSummaryMessage = "批量签名完成：成功 \(okCount) 个，失败 \(failCount) 个。\n\(details)"
+        }
+        return report
+    }
+
+    func resignAllSignedApps(
+        using certificate: CertificatePair,
+        options: Options = OptionsManager.shared.options
+    ) async -> BatchReport<String, String> {
+        let request: NSFetchRequest<Signed> = Signed.fetchRequest()
+        request.sortDescriptors = [NSSortDescriptor(keyPath: \Signed.date, ascending: false)]
+        let signedApps = (try? Storage.shared.context.fetch(request)) ?? []
+        return await signBatch(apps: signedApps, certificate: certificate, options: options)
+    }
+}
