 import SwiftUI
 
 struct VariedTabbarView: View {
+	#if ONETOOLS_EMBEDDED
+	@State private var selectedTab: TabEnum = .library
+	@State private var expiringCertCount: Int = 0
+	private let embeddedTabs: [TabEnum] = [.library, .sources, .certificates, .settings]
+	#endif
+
 	init() {}
 	
 	var body: some View {
+		#if ONETOOLS_EMBEDDED
+		VStack(spacing: 6) {
+			FeatherSlidingPillBar(tabs: embeddedTabs, selectedTab: $selectedTab)
+				.padding(.horizontal, 16)
+				.padding(.top, 4)
+
+			if expiringCertCount > 0 && selectedTab != .certificates {
+				FeatherCertExpiryWarningBar(expiringCount: expiringCertCount) {
+					withAnimation(.timingCurve(0.22, 1.0, 0.36, 1.0, duration: 0.24)) {
+						selectedTab = .certificates
+					}
+				}
+				.padding(.horizontal, 16)
+				.transition(.opacity.combined(with: .move(edge: .top)))
+			}
+
+			ZStack {
+				TabEnum.view(for: selectedTab)
+			}
+			.frame(maxWidth: .infinity, maxHeight: .infinity)
+		}
+		.onAppear {
+			expiringCertCount = CertificateExpiryNotifier.shared.expiringSoonCount(withinDays: 7)
+		}
+		.onChange(of: selectedTab) { _ in
+			expiringCertCount = CertificateExpiryNotifier.shared.expiringSoonCount(withinDays: 7)
+		}
+		.onReceive(NotificationCenter.default.publisher(for: OneToolsFeatherBridge.selectSubtabNotification)) { note in
+			if let raw = note.userInfo?["tab"] as? String, let matched = TabEnum(rawValue: raw) {
+				withAnimation(.timingCurve(0.22, 1.0, 0.36, 1.0, duration: 0.24)) {
+					selectedTab = matched
+				}
+			}
+		}
+		#else
 		if #available(iOS 18, *) {
 			ExtendedTabbarView()
 		} else {
 			TabbarView()
 		}
+		#endif
 	}
 }
