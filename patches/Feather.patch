+struct FeatherRhythmBars: View {
+	var color: Color = .primary
+	var height: CGFloat = 14
+	@Environment(\.accessibilityReduceMotion) private var reduceMotion
+	@State private var pulsing = false
+
+	var body: some View {
+		HStack(spacing: 3) {
+			ForEach(0..<3, id: \.self) { idx in
+				Capsule()
+					.fill(color)
+					.frame(width: 2.5, height: barHeight(idx))
+					.animation(
+						reduceMotion
+							? nil
+							: .easeInOut(duration: 0.42)
+								.repeatForever(autoreverses: true)
+								.delay(Double(idx) * 0.12),
+						value: pulsing
+					)
+			}
+		}
+		.frame(width: 15, height: height)
+		.onAppear {
+			guard !reduceMotion else { return }
+			pulsing = true
+		}
+	}
+
+	private func barHeight(_ idx: Int) -> CGFloat {
+		if reduceMotion { return idx == 1 ? height : height * 0.6 }
+		return pulsing ? (idx == 1 ? height * 0.42 : height) : (idx == 1 ? height : height * 0.45)
+	}
+}
