+/// Damped tactile swipe-to-confirm control for irreversible reset actions.
+struct FeatherSwipeConfirm: View {
+	let title: String
+	let onConfirm: () -> Void
+
+	@Environment(\.accessibilityReduceMotion) private var reduceMotion
+	@State private var dragOffset: CGFloat = 0
+	@State private var done = false
+
+	private let thumb: CGFloat = 38
+	private let pad: CGFloat = 4
+
+	var body: some View {
+		GeometryReader { geo in
+			let maxTravel = max(1, geo.size.width - thumb - pad * 2)
+			let progress = min(max(dragOffset / maxTravel, 0), 1)
+			let tone = FeatherBeamTone.crimson.color
+
+			ZStack(alignment: .leading) {
+				Capsule()
+					.fill(tone.opacity(0.10 + progress * 0.16))
+					.overlay {
+						Capsule().strokeBorder(tone.opacity(0.28), lineWidth: 0.8)
+					}
+
+				Text(done ? "已重置全部自签数据" : title)
+					.font(.system(size: 13, weight: .semibold))
+					.foregroundStyle(tone)
+					.opacity(done ? 1.0 : Double(1.0 - progress * 0.65))
+					.frame(maxWidth: .infinity)
+
+				Circle()
+					.fill(tone)
+					.frame(width: thumb, height: thumb)
+					.overlay {
+						Image(systemName: done ? "checkmark" : "chevron.right.2")
+							.font(.system(size: 12, weight: .bold))
+							.foregroundStyle(.white)
+					}
+					.offset(x: pad + (done ? maxTravel : dragOffset))
+					.gesture(
+						DragGesture(minimumDistance: 2)
+							.onChanged { val in
+								guard !done else { return }
+								dragOffset = min(max(0, val.translation.width), maxTravel)
+							}
+							.onEnded { val in
+								guard !done else { return }
+								if val.translation.width / maxTravel >= 0.82 {
+									UIImpactFeedbackGenerator(style: .rigid).impactOccurred()
+									withAnimation(reduceMotion ? nil : .easeOut(duration: 0.16)) {
+										dragOffset = maxTravel
+										done = true
+									}
+									onConfirm()
+									DispatchQueue.main.asyncAfter(deadline: .now() + 1.2) {
+										withAnimation(reduceMotion ? nil : .easeOut(duration: 0.2)) {
+											done = false
+											dragOffset = 0
+										}
+									}
+								} else {
+									withAnimation(reduceMotion ? nil : .spring(response: 0.24, dampingFraction: 0.8)) {
+										dragOffset = 0
+									}
+								}
+							}
+					)
+			}
+		}
+		.frame(height: thumb + pad * 2)
+	}
+}
