+private enum OneToolsCertificateInbox {
+	private static var stagedP12URL: URL?
+	private static var stagedProvisionURL: URL?
+
+	static func accept(_ incomingURL: URL) {
+		let ext = incomingURL.pathExtension.lowercased()
+		guard ext == "p12" || ext == "mobileprovision" else { return }
+
+		let scoped = incomingURL.startAccessingSecurityScopedResource()
+		defer {
+			if scoped {
+				incomingURL.stopAccessingSecurityScopedResource()
+			}
+		}
+
+		let fm = FileManager.default
+		let inboxDir = fm.temporaryDirectory.appendingPathComponent("FeatherCertInbox", isDirectory: true)
+		try? fm.createDirectoryIfNeeded(at: inboxDir)
+		let dstURL = inboxDir.appendingPathComponent("\(UUID().uuidString).\(ext)")
+		do {
+			try? fm.removeItem(at: dstURL)
+			try fm.copyItem(at: incomingURL, to: dstURL)
+		} catch {
+			UIAlertController.showAlertWithOk(title: .localized("Error"), message: error.localizedDescription)
+			return
+		}
+
+		if ext == "p12" {
+			if let old = stagedP12URL { try? fm.removeItem(at: old) }
+			stagedP12URL = dstURL
+		} else {
+			if let old = stagedProvisionURL { try? fm.removeItem(at: old) }
+			stagedProvisionURL = dstURL
+		}
+
+		OneToolsFeatherBridge.selectSubtab("certificates")
+
+		guard let p12URL = stagedP12URL, let provisionURL = stagedProvisionURL else {
+			let missing = (ext == "p12") ? ".mobileprovision 描述文件" : ".p12 证书私钥"
+			UIAlertController.showAlertWithOk(
+				title: "已暂存证书组件",
+				message: "已接收 \(incomingURL.lastPathComponent)。请继续导入配套的 \(missing) 即可输入密码一键完成配对，或直接在「证书」页手动添加。"
+			)
+			return
+		}
+
+		DispatchQueue.main.async {
+			presentPasswordPrompt(p12URL: p12URL, provisionURL: provisionURL)
+		}
+	}
+
+	private static func presentPasswordPrompt(p12URL: URL, provisionURL: URL) {
+		let alert = UIAlertController(
+			title: "导入配对证书",
+			message: "已备齐 .p12 与 .mobileprovision，请输入证书密码完成导入（无密码可留空）：",
+			preferredStyle: .alert
+		)
+		alert.addTextField { tf in
+			tf.placeholder = "证书密码"
+			tf.isSecureTextEntry = true
+		}
+		alert.addAction(UIAlertAction(title: .localized("Cancel"), style: .cancel))
+		alert.addAction(UIAlertAction(title: .localized("Import"), style: .default) { _ in
+			let password = alert.textFields?.first?.text ?? ""
+			guard FR.checkPasswordForCertificate(for: p12URL, with: password, using: provisionURL) else {
+				UIAlertController.showAlertWithOk(title: .localized("Error"), message: "证书密码校验失败或与描述文件不匹配，请重试。")
+				return
+			}
+			FR.handleCertificateFiles(p12URL: p12URL, provisionURL: provisionURL, p12Password: password) { error in
+				let fm = FileManager.default
+				try? fm.removeItem(at: p12URL)
+				try? fm.removeItem(at: provisionURL)
+				stagedP12URL = nil
+				stagedProvisionURL = nil
+				if let error {
+					UIAlertController.showAlertWithOk(title: .localized("Error"), message: error.localizedDescription)
+				} else {
+					CertificateExpiryNotifier.shared.syncNotifications()
+				}
+			}
+		})
+		UIApplication.topViewController()?.present(alert, animated: true)
+	}
+}
